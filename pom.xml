<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.github.leasegate</groupId>
    <artifactId>bwgate</artifactId>
    <version>0.3-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>bwgate</name>
    <description>A Bitwarden or Vaultwarden vault behind a leasegate gate: a pure-Java client that keeps the vault key in the tray, and releases one item or one folder at a time, per process and for a limited time, after a human has seen who is asking.</description>
    <url>https://github.com/leasegate/bwgate</url>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>leasegate</id>
            <name>Ivan Velikanov</name>
            <email>ivan.velikanov.dev@gmail.com</email>
            <url>https://github.com/leasegate</url>
        </developer>
    </developers>
    <scm>
        <url>https://github.com/leasegate/bwgate</url>
        <connection>scm:git:https://github.com/leasegate/bwgate.git</connection>
        <developerConnection>scm:git:git@github.com:leasegate/bwgate.git</developerConnection>
    </scm>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <leasegate.version>0.2</leasegate.version>
        <jackson.version>2.21.2</jackson.version>
        <datahelper.version>2.0</datahelper.version>
        <main.class>leasegate.bwgate.BwgateMain</main.class>
    </properties>
    <dependencies>
        <dependency>
            <groupId>io.github.leasegate</groupId>
            <artifactId>leasegate-ui</artifactId>
            <version>${leasegate.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-toml</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.datapotter</groupId>
            <artifactId>datapotter-datahelper-base</artifactId>
            <version>${datahelper.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.datapotter</groupId>
            <artifactId>datapotter-datahelper-annotations</artifactId>
            <version>${datahelper.version}</version>
        </dependency>
    </dependencies>
    <build>
        <finalName>bwgate</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>io.github.datapotter</groupId>
                            <artifactId>datapotter-datahelper-processor</artifactId>
                            <version>${datahelper.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${main.class}</mainClass>
                                    <manifestEntries>
                                        <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>release</id>
            <activation>
                <property><name>org.name</name></property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals><goal>jar-no-fork</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.6.3</version>
                        <configuration>
                            <doclint>none</doclint>
                            <additionalOptions>--no-fonts</additionalOptions>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals><goal>jar</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                            </execution>
                        </executions>
                        <configuration>
                            <keyname>${org.gpg.keyname}</keyname>
                            <passphrase>${org.gpg.passphrase}</passphrase>
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.9.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>${org.publishing.server.id}</publishingServerId>
                            <autoPublish>true</autoPublish>
                            <waitUntil>published</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>javafx-win</id>
            <activation><os><family>windows</family></os></activation>
            <properties><javafx.platform>win</javafx.platform></properties>
        </profile>
        <profile>
            <id>jrexe</id>
            <activation><property><name>jrexe</name></property></activation>
            <properties>
                <!-- The exe's own version. release.ps1 passes X.Y.Z-label for a beta, which follows the beta channel only. -->
                <jrexe.version>${project.version}</jrexe.version>
                <jrexe.channel>stable</jrexe.channel>
                <jrexe.release>https://github.com/leasegate/bwgate/releases/download/v${jrexe.version}</jrexe.release>
                <jrexe.updates>https://leasegate.github.io/bwgate/update</jrexe.updates>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>io.github.jarrunner</groupId>
                        <artifactId>jr-maven-plugin</artifactId>
                        <version>1.3.0</version>
                        <executions>
                            <execution><goals><goal>exe</goal></goals></execution>
                        </executions>
                        <configuration>
                            <name>bwgate</name>
                            <appVersion>${jrexe.version}</appVersion>
                            <jarUrl>${jrexe.release}/bwgate-{sha8}.jar</jarUrl>
                            <updateUrl>${jrexe.updates}/bwgate.json</updateUrl>
                            <updateChannel>${jrexe.channel}</updateChannel>
                            <icon>${project.basedir}/src/main/jr/bwgate.ico</icon>
                            <appId>io.github.leasegate:bwgate</appId>
                            <fileDescription>bwgate</fileDescription>
                            <productName>bwgate</productName>
                            <companyName>leasegate</companyName>
                            <copyright>leasegate contributors</copyright>
                            <javaVersion>25+</javaVersion>
                            <jvmMode>dll</jvmMode>
                            <!-- A tray that holds one decrypted vault: small heap, Serial GC (smallest footprint, gives memory back), C1 only. -->
                            <vmArgs>
                                <vmArg>-Xms16m</vmArg>
                                <vmArg>-Xmx96m</vmArg>
                                <vmArg>-Xss512k</vmArg>
                                <vmArg>-XX:+UseSerialGC</vmArg>
                                <vmArg>-XX:MinHeapFreeRatio=10</vmArg>
                                <vmArg>-XX:MaxHeapFreeRatio=30</vmArg>
                                <vmArg>-XX:TieredStopAtLevel=1</vmArg>
                                <vmArg>-XX:MaxMetaspaceSize=96m</vmArg>
                                <vmArg>-XX:ReservedCodeCacheSize=32m</vmArg>
                                <vmArg>-XX:MaxDirectMemorySize=32m</vmArg>
                                <vmArg>--enable-native-access=ALL-UNNAMED</vmArg>
                            </vmArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
